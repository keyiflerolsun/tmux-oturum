#!/usr/bin/env bash
# Bu araç @keyiflerolsun tarafından | @KekikAkademi için yazılmıştır.

# tmux-oturum: yerel makinenin, Tailscale'deki makinelerin ve @oturum-makineler'in tmux oturumları tek fzf listesinde.
#   oturum                       arayüz (tmux'ta prefix g, zsh'ta ctrl-g)
#   oturum liste                 fzf satırları "kimlik<TAB>görünen"
#   oturum dizinler <kimlik>     satırın makinesindeki dizinler
#   oturum onizle | kapat | adlandir | baglan <kimlik>
# Kimlik "makine|ne": makine "yerel", Tailscale ya da ssh config adı; ne "=oturum", "=oturum:pencere", "dizin|/yol", "yeni|ad",
# "kayit|ad" (tmux-resurrect'in kaydında olup açık olmayan yerel oturum), "yetki" (Tailscale SSH onayı) ya da "+" (makinede yeni
# oturum).

BEN="$(readlink -f "${BASH_SOURCE[0]}")"
secenek() { local deger; deger=$(tmux show-option -gqv "$1" 2>/dev/null); echo "${deger:-$2}"; }

# ControlMaster: ilk bağlantı 10 dk açık kalır, sonraki liste ve önizlemeler beklemez. C.UTF-8: tr_TR yerelinde OpenSSH büyük
# I'lı ayar sözcüklerini (Include) tanımıyor. Tailscale makinelerinin host anahtarları $BILINEN'e makineler() yazar.
BILINEN="${XDG_RUNTIME_DIR:-/tmp}/tmux-oturum-bilinen"
SSH=(env LC_ALL=C.UTF-8 ssh -o BatchMode=yes -o ConnectTimeout=3 -o ControlMaster=auto -o "ControlPath=${XDG_RUNTIME_DIR:-/tmp}/tmux-oturum-%C"
     -o ControlPersist=10m -o "UserKnownHostsFile=~/.ssh/known_hosts $BILINEN")
EK=" $(secenek @oturum-makineler '') "
FMT_O=$'O\t#{session_activity}\t#{session_name}\t#{session_windows}\t#{session_attached}'
FMT_P=$'P\t#{session_activity}\t#{session_name}\t#{window_index}\t#{window_name}\t#{window_active}'
LISTE_KOMUTU="tmux list-sessions -F '$FMT_O' 2>/dev/null; tmux list-windows -a -F '$FMT_P' 2>/dev/null; command -v tmux >/dev/null && echo +"
YEREL=$(uname -n)
# Dracula: makine yeşil (yerel) / camgöbeği (uzak), oturum kalın, ayrıntı soluk, bağlı pembe, dizin mor, kayıtlı turuncu
R=$'\e[0m' KALIN=$'\e[1m' SOLUK=$'\e[38;2;98;114;164m' YESIL=$'\e[38;2;80;250;123m' CAMGOBEGI=$'\e[38;2;139;233;253m'
PEMBE=$'\e[38;2;255;121;198m' MOR=$'\e[38;2;189;147;249m' SARI=$'\e[3;38;2;241;250;140m' TURUNCU=$'\e[38;2;255;184;108m'
# Hizalama ${#ad} ile: UTF-8 dışı yerelde bayt sayılır, Türkçe harfli ad kayar
[[ $(locale charmap 2>/dev/null) == UTF-8 ]] || export LC_ALL=C.UTF-8
# Ev dizini ilk satır, sonra zoxide geçmişi; sunucularda iş çoğu kez ev dizininde değil, /opt, /srv, /DATA (casaos) da taranır
DIZIN_KOMUTU='{ echo ~; command -v zoxide >/dev/null && zoxide query -l; find ~ -mindepth 1 -maxdepth 2 -type d -not -path "*/.*" 2>/dev/null
               find /opt /srv /DATA -mindepth 1 -maxdepth 1 -type d -not -name ".*" 2>/dev/null; } | awk "!g[\$0]++" | head -300'

# Açık, Linux ve Tailscale SSH'ı olan makineler, her açılışta tailscale status'tan; @oturum-makineler önce
makineler() {
    {
        printf '%s\n' $EK
        local durum
        command -v tailscale >/dev/null && command -v jq >/dev/null && durum=$(tailscale status --json 2>/dev/null) || durum='{}'
        jq -r '.Peer[]? | select(.sshHostKeys) | (.DNSName | split(".")[0]) as $ad | .sshHostKeys[] | "\($ad) \(.)"' <<<"$durum" >"$BILINEN"
        jq -r '.Peer[]? | select(.Online and .sshHostKeys != null and .OS == "linux") | .DNSName | split(".")[0]' <<<"$durum"
    } | awk 'NF && !g[$0]++'
}

# @oturum-makineler ssh config'teki gibi (kullanıcı, port, anahtar oradan), Tailscale'dekiler root ile
hedef() { [[ $EK == *" $1 "* ]] && echo "$1" || echo "root@$1"; }

# Uzak komut yerel ayarsız koşar: UTF-8 verilmezse tmux Türkçe harfi "_" yapar
calistir() {
    local makine=$1; shift
    if [[ $makine == yerel ]]; then bash -c "$*"; else "${SSH[@]}" "$(hedef "$makine")" "export LC_ALL=C.UTF-8; $*"; fi
}

# Ham satır: sıra (yerel 0, uzak 1), makine, baş (+ ve onay satırı 0, makine adı onunla aynı satırda), etkinlik, oturum,
# tür (oturum 0, pencere 1), pencere no, sonra bicimle'nin girdisi "kimlik<TAB>tür<TAB>a<TAB>b<TAB>c".
ham() {
    local sira=$1 makine=$2 tur etkinlik ad a b c
    while IFS=$'\t' read -r tur etkinlik ad a b c; do
        case $tur in
            O) printf '%s\t%s\t1\t%s\t%s\t0\t0\t%s|=%s\tO\t%s\t%s\t%s\n' "$sira" "$makine" "$etkinlik" "$ad" "$makine" "$ad" "$ad" "$a" "$b" ;;
            P) printf '%s\t%s\t1\t%s\t%s\t1\t%s\t%s|=%s:%s\tP\t%s\t%s\t%s\n' "$sira" "$makine" "$etkinlik" "$ad" "$a" "$makine" "$ad" "$a" "$a" "$b" "$c" ;;
            K) printf '%s\t%s\t2\t%s\t%s\t0\t0\t%s|kayit|%s\tK\t%s\t%s\t%s\n' "$sira" "$makine" "$etkinlik" "$ad" "$makine" "$ad" "$ad" "$a" "$b" ;;
            +) printf '%s\t%s\t0\t0\t\t0\t0\t%s|+\t+\n' "$sira" "$makine" "$makine" ;;
            *login.tailscale.com*) printf '%s\t%s\t0\t0\t\t0\t0\t%s|yetki\tY\n' "$sira" "$makine" "$makine" ;;
        esac
    done
}

dolgu() { printf '%s%*s' "$1" $(($2 - ${#1})) ''; }

# Sütunlar en uzun makine ve oturum adına göre hizalı; makine adı yalnız makinenin ilk satırında, pencereler oturumun altında ağaç
bicimle() {
    local satirlar=() kimlik tur a b c makine tam onceki genis_m=0 genis_o=0 renk govde i sonraki dal
    while IFS=$'\t' read -r kimlik tur a b c; do
        makine=${kimlik%%|*}; [[ $makine == yerel ]] && makine=$YEREL
        satirlar+=("$kimlik"$'\t'"$tur"$'\t'"$a"$'\t'"$b"$'\t'"$c")
        (( ${#makine} > genis_m )) && genis_m=${#makine}
        [[ $tur == [OK] ]] && (( ${#a} > genis_o )) && genis_o=${#a}
    done
    for i in "${!satirlar[@]}"; do
        IFS=$'\t' read -r kimlik tur a b c <<<"${satirlar[i]}"
        tam=${kimlik%%|*}; [[ $tam == yerel ]] && tam=$YEREL
        [[ $kimlik == yerel\|* ]] && renk=$YESIL || renk=$CAMGOBEGI
        [[ ${kimlik%%|*} == "$onceki" || $tur == P ]] && makine="" || { makine=$tam; onceki=${kimlik%%|*}; }
        case $tur in
            +) govde="$SOLUK+ yeni oturum$R  ${SOLUK}ctrl-f: dizin seç$R" ;;
            Y) govde="$SARI! Tailscale onayı bekliyor$R  ${SOLUK}enter: onayla$R" ;;
            O) govde="$KALIN$(dolgu "$a" "$genis_o")$R  $SOLUK$(printf "%2s" "$b") pencere$R"
               (( c > 0 )) && govde+="  $PEMBE● bağlı$R" ;;
            K) govde="$TURUNCU$(dolgu "$a" "$genis_o")$R  $SOLUK$(printf "%2s" "$b") pencere$R  $TURUNCU↺ kayıtlı$R $SOLUK$c$R" ;;
            P) IFS=$'\t' read -r _ sonraki _ <<<"${satirlar[i+1]}"
               [[ $sonraki == P ]] && dal="├" || dal="└"
               govde="$SOLUK$dal$R $SOLUK$a$R $b"
               (( c > 0 )) && govde+=" $YESIL•$R" ;;
        esac
        # 2. alan ağaç (makine adı yalnız ilk satırında), 3. alan aramada: makine adı her satırda, "nas" yazınca nas'ın bütün
        # oturum ve pencereleri kalır (fzf gizli alanda aramaz, arayüz sorgu yazılınca bu alana geçer)
        printf '%s\t%s  %s\t%s  %s\n' "$kimlik" "$renk$(dolgu "$makine" "$genis_m")$R" "$govde" "$renk$(dolgu "$tam" "$genis_m")$R" "$govde"
    done
}

# Makineler paralel, her biri en çok 5 sn: kapalı ya da girişte uzun çıktı basan makine listeyi bekletmez. Tailscale SSH "check"
# kuralında ssh onay adresini stderr'e basıp bekler: makine onay satırı olur. Adres listede yok, ssh kesilince geçersiz kalır;
# enter yenisini alır.
liste() {
    {
        { bash -c "$LISTE_KOMUTU"; kayitlar; } | ham 0 yerel
        for makine in $(makineler); do
            timeout 5 "${SSH[@]}" "$(hedef "$makine")" "export LC_ALL=C.UTF-8; $LISTE_KOMUTU" 2>&1 | tr -d "\r" \
                | grep -aE $'^[OP]\t|^\\+$|^# To authenticate, visit: https://login\\.tailscale\\.com/' | ham 1 "$makine" &
        done
        wait
    } | sort -t$'\t' -k1,1n -k2,2 -k3,3n -k4,4rn -k5,5 -k6,6n -k7,7n | cut -f8- | bicimle
}

# tmux-resurrect kayıtları: yeri eklentinin kuralıyla (@resurrect-dir; yoksa eski ~/.tmux/resurrect ya da XDG). Dosyalar
# yeniden eskiye: continuum her kayıtta yalnız açık oturumları yazar, kapanan oturum yalnız eski dosyalarda kalır.
kayit_dizini() {
    local dizin; dizin=$(secenek @resurrect-dir '')
    if [[ $dizin ]]; then dizin=${dizin/#\~/$HOME} dizin=${dizin//\$HOME/$HOME} dizin=${dizin//\$HOSTNAME/$(uname -n)}
    elif [[ -d ~/.tmux/resurrect ]]; then dizin=~/.tmux/resurrect
    else dizin=${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect; fi
    echo "$dizin"
}
kayit_dosyalari() { local d; d=$(kayit_dizini); compgen -G "$d/tmux_resurrect_*.txt" | sort -r; }

# Açık olmayan her oturumun en yeni kaydı: "K<TAB>sıra<TAB>ad<TAB>pencere sayısı<TAB>gün"; sıra dosya adındaki zamandan
kayitlar() {
    local dosyalar; mapfile -t dosyalar < <(kayit_dosyalari)
    (( ${#dosyalar[@]} )) || return 0
    awk -F'\t' 'FILENAME == ARGV[1] { acik[$0]; next }
        ($1 == "window" || $1 == "pane") && !($2 in acik) {
            if (!($2 in dosya)) dosya[$2] = FILENAME
            if (dosya[$2] == FILENAME && $1 == "window") n[$2]++
        }
        END { for (s in dosya) { z = dosya[s]; sub(/.*_/, "", z)
            printf "K\t%s%s\t%s\t%d\t%s.%s %s:%s\n", substr(z, 1, 8), substr(z, 10, 6), s, n[s],
                substr(z, 7, 2), substr(z, 5, 2), substr(z, 10, 2), substr(z, 12, 2) } }' \
        <(tmux list-sessions -F '#{session_name}' 2>/dev/null) "${dosyalar[@]}"
}

kayit_dosyasi() {
    local dosya
    while IFS= read -r dosya; do
        awk -F'\t' -v s="$1" '$1 == "window" && $2 == s { bulundu = 1; exit } END { exit !bulundu }' "$dosya" && { echo "$dosya"; return; }
    done < <(kayit_dosyalari)
    return 1
}

# Oturumu en yeni kaydından kurar: pencereler, adları, bölmeler, dizinleri ve düzen. Bölmelerin içeriği ve çalışan programlar
# gelmez (onlar resurrect'in bütün sunucuyu yükleyen prefix C-r'ında). Satırlar resurrect'in save.sh biçiminde: alanların
# başındaki ":" boş alanı sekmeye karşı korur.
kur() {
    local ad=$1 dosya tur s pno etkin bayrak bno baslik dizin betkin pad yerlesim otomatik bolme etkin_pencere etkin_bolmeler=()
    tmux has-session -t "=$ad" 2>/dev/null && return 0
    dosya=$(kayit_dosyasi "$ad") || return 1
    # Ayırıcı \037: sekme IFS'te boşluk sayılır, art arda sekmeler birleşip boş alan (başlıksız bölme) kayar
    while IFS=$'\037' read -r tur s pno etkin bayrak bno baslik dizin betkin _; do
        [[ $tur == pane && $s == "$ad" ]] || continue
        dizin=${dizin#:}; [[ -d $dizin ]] || dizin=$HOME
        if ! tmux has-session -t "=$ad" 2>/dev/null; then
            bolme=$(tmux new-session -d -P -F '#{pane_id}' -s "$ad" -c "$dizin")
            tmux move-window -s "=$ad:" -t "=$ad:$pno" 2>/dev/null
        elif ! tmux list-windows -t "=$ad" -F '#{window_index}' | grep -qx "$pno"; then
            bolme=$(tmux new-window -d -P -F '#{pane_id}' -t "=$ad:$pno" -c "$dizin")
        else
            bolme=$(tmux split-window -d -P -F '#{pane_id}' -t "=$ad:$pno" -c "$dizin")
        fi
        # Bölme no değil kimlik: pane-base-index kayıttan sonra değiştiyse no kayar
        [[ $baslik ]] && tmux select-pane -t "$bolme" -T "$baslik"
        [[ $betkin == 1 ]] && etkin_bolmeler+=("$bolme")
    done < <(tr '\t' '\037' <"$dosya")
    while IFS=$'\037' read -r tur s pno pad etkin bayrak yerlesim otomatik; do
        [[ $tur == window && $s == "$ad" ]] || continue
        tmux rename-window -t "=$ad:$pno" "${pad#:}"
        [[ $otomatik == on ]] && tmux set-window-option -t "=$ad:$pno" automatic-rename on
        tmux select-layout -t "=$ad:$pno" "$yerlesim" 2>/dev/null
        [[ $etkin == 1 ]] && etkin_pencere="=$ad:$pno"
    done < <(tr '\t' '\037' <"$dosya")
    for bno in "${etkin_bolmeler[@]}"; do tmux select-pane -t "$bno"; done
    [[ $etkin_pencere ]] && tmux select-window -t "$etkin_pencere"
    return 0
}

# Kayıtlı oturumun pencereleri; çok bölmeli pencerenin düzeni kutularla, önizlemenin genişliğine ölçekli. Düzen tmux 3.8'in JSON
# biçiminde ({"t":"p","w":..} yaprakları) ya da eski "sağlama,GxY,x,y{...}" dizgisinde; yapraklar bölme sırasıyla gelir.
kayit_onizle() {
    awk -F'\t' -v s="$2" -v gen="$(( $3 - 4 > 70 ? 70 : $3 - 4 ))" -v ev="$HOME" -v pembe="$PEMBE" -v yesil="$YESIL" \
        -v sol="$SOLUK" -v r="$R" '
    function kisa(d) { if (index(d, ev) == 1) d = "~" substr(d, length(ev) + 1); return d }
    function son(d,   n, parca) { sub(/\/$/, "", d); n = split(d, parca, "/"); return n ? parca[n] : d }
    function yuvarla(v) { return int(v + 0.5) }
    # Kenar bitleri üst 1, alt 2, sol 4, sağ 8; hücrenin karakteri bitlerin toplamından (kesişimler ├ ┬ ┼ kendiliğinden)
    function cizgi(y, x, bit) { if (!((y, x, bit) in kenar)) { kenar[y, x, bit]; izgara[y, x] += bit } }
    function kutu(x0, y0, x1, y1,   x, y) {
        for (x = x0; x < x1; x++) { cizgi(y0, x, 8); cizgi(y0, x + 1, 4); cizgi(y1, x, 8); cizgi(y1, x + 1, 4) }
        for (y = y0; y < y1; y++) { cizgi(y, x0, 2); cizgi(y + 1, x0, 1); cizgi(y, x1, 2); cizgi(y + 1, x1, 1) }
    }
    # Harf sayısı ve kesme hem UTF-8 bilen awk (gawk) hem baytla çalışan awk (mawk) için doğru: bayt kipinde UTF-8 devam baytı
    # sayılmaz, kesme harfin ortasına düşmez. Bayt aralığı UTF-8 kipinde geçersiz düzenli ifade: yalnız bayt kipinde kullanılır.
    function uzunluk(t) { return utf ? length(t) : length(t) - gsub(devam, "", t) }
    function kes(t, en,   i, n) {
        if (utf) return substr(t, 1, en)
        for (i = 1; i <= length(t); i++) if (substr(t, i, 1) !~ devam && ++n > en) return substr(t, 1, i - 1)
        return t
    }
    # Etiket ilk hücresine bütün yazılır, kapladığı öteki hücreler atlanır
    function yaz(y, x, metin, renk, en,   k, n) {
        metin = kes(metin, en); n = uzunluk(metin)
        if (!n) return
        harf[y, x] = metin; boya[y, x] = renk
        for (k = 1; k < n; k++) ortu[y, x + k]
    }
    function ciz(pno, yer,   tg, ty, n, t, a, i, G, Y, x0, y0, x1, y1, y, x, satir, onceki, h, rk) {
        delete izgara; delete kenar; delete harf; delete boya; delete ortu; n = 0
        if (substr(yer, 1, 1) == "{") {
            t = yer; match(t, /"w":[0-9]+,"h":[0-9]+/); t = substr(t, RSTART, RLENGTH); gsub(/[^0-9,]/, "", t); split(t, a, ","); tg = a[1]; ty = a[2]
            while (match(yer, /"t":"p","w":[0-9]+,"h":[0-9]+,"x":[0-9]+,"y":[0-9]+/)) {
                t = substr(yer, RSTART, RLENGTH); yer = substr(yer, RSTART + RLENGTH); gsub(/[^0-9,]/, "", t); split(t, a, ",")
                n++; w_[n] = a[2]; h_[n] = a[3]; x_[n] = a[4]; y_[n] = a[5]
            }
        } else {
            sub(/^[0-9a-f]+,/, "", yer); match(yer, /[0-9]+x[0-9]+/); t = substr(yer, RSTART, RLENGTH); split(t, a, "x"); tg = a[1]; ty = a[2]
            while (match(yer, /[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+/)) {
                t = substr(yer, RSTART, RLENGTH); yer = substr(yer, RSTART + RLENGTH); gsub(/x/, ",", t); split(t, a, ",")
                n++; w_[n] = a[1]; h_[n] = a[2]; x_[n] = a[3]; y_[n] = a[4]
            }
        }
        if (n < 2 || !tg || !ty) return
        # Karakter iki kat uzun: yükseklik genişliğin yarısı oranında, 6-14 satır
        G = gen - 1; Y = yuvarla(G * ty / tg / 2); if (Y < 6) Y = 6; if (Y > 14) Y = 14
        for (i = 1; i <= n; i++) {
            # Kenar tmux ayırıcısının üstünde: sol/üst kenar x-1 (pencere kenarında 0), sağ/alt x+w; komşu kutular kenarı paylaşır
            x0 = yuvarla((x_[i] ? x_[i] - 1 : 0) * G / tg); x1 = yuvarla((x_[i] + w_[i]) * G / tg)
            y0 = yuvarla((y_[i] ? y_[i] - 1 : 0) * Y / ty); y1 = yuvarla((y_[i] + h_[i]) * Y / ty)
            kutu(x0, y0, x1, y1)
            if (y1 - y0 > 1) yaz(y0 + 1, x0 + 1, (i - 1 + taban[pno]) " " son(dizin[pno, i]), etkin[pno, i] ? yesil : pembe, x1 - x0 - 1)
            # Komut kutunun sağ alt köşesinde; kutu darsa sonu kesilip sağa yaslanır
            if (y1 - y0 > 2) { t = kes(komut[pno, i], x1 - x0 - 1); yaz(y1 - 1, x1 - uzunluk(t), t, sol, x1 - x0 - 1) }
        }
        for (y = 0; y <= Y; y++) {
            satir = "    "; onceki = ""
            for (x = 0; x <= G; x++) {
                if ((y, x) in ortu) continue
                if ((y, x) in harf) { h = harf[y, x]; rk = boya[y, x] }
                else { h = sekil[izgara[y, x] + 0]; rk = sol }
                if (rk != onceki) { satir = satir r rk; onceki = rk }
                satir = satir h
            }
            print satir r
        }
    }
    BEGIN {
        split(" ,│,│,│,─,┘,┐,┤,─,└,┌,├,─,┴,┬,┼", sk, ",")
        for (i = 0; i < 16; i++) sekil[i] = sk[i + 1]
        utf = length("ş") == 1; devam = "[\200-\277]"
    }
    $1 == "pane" && $2 == s {
        if (!($3 in bolme)) taban[$3] = $6
        bolme[$3]++; dizin[$3, bolme[$3]] = substr($8, 2); komut[$3, bolme[$3]] = $10; etkin[$3, bolme[$3]] = ($9 == 1)
    }
    $1 == "window" && $2 == s { sira[++np] = $3; ad[$3] = substr($4, 2); yerlesim[$3] = $7; aktif[$3] = ($5 == 1) }
    END {
        for (i = 1; i <= np; i++) { p = sira[i]
            printf "\n  %s%2s%s %s%s%s  %s%d bölme  %s%s\n", pembe, p, r, aktif[p] ? yesil : "", ad[p], r, sol, bolme[p], kisa(dizin[p, 1]), r
            if (bolme[p] > 1) ciz(p, yerlesim[p])
        }
    }' "$1"
}

# Kaydı unutur: oturumun satırları bütün kayıt dosyalarından silinir, dosyanın günü korunur (resurrect eskileri güne göre siler)
unut() {
    local dosya gecici
    while IFS= read -r dosya; do
        awk -F'\t' -v s="$1" '($1 == "window" || $1 == "pane" || $1 == "grouped_session") && $2 == s { bulundu = 1; exit } END { exit !bulundu }' "$dosya" || continue
        gecici=$(mktemp "$dosya.XXXXXX")
        awk -F'\t' -v s="$1" '!(($1 == "window" || $1 == "pane" || $1 == "grouped_session") && $2 == s)' "$dosya" >"$gecici" \
            && touch -r "$dosya" "$gecici" && chmod --reference="$dosya" "$gecici" && mv -f "$gecici" "$dosya" || rm -f "$gecici"
    done < <(kayit_dosyalari)
}

dizinler() {
    local makine=$1 ad=$1 yol ev renk gorunen
    [[ $makine == yerel ]] && ad=$YEREL renk=$YESIL || renk=$CAMGOBEGI
    calistir "$makine" "$DIZIN_KOMUTU" 2>/dev/null | while IFS= read -r yol; do
        ev=${ev:-$yol}
        [[ $yol == "$ev" || $yol == "$ev"/* ]] && gorunen="~${yol#"$ev"}" || gorunen=$yol
        printf '%s|dizin|%s\t%s%s%s  %s%s%s\t%s%s%s  %s%s%s\n' "$makine" "$yol" "$renk" "$ad" "$R" "$MOR" "$gorunen" "$R" \
            "$renk" "$ad" "$R" "$MOR" "$gorunen" "$R"
    done
}

# Tuş rehberi: iki satır kısayol, bir satır ipucu, ayırıcı çizgi; 54 sütun (onizleme_yeri liste sütununu bundan dar tutmaz)
baslik() {
    local t=$PEMBE a=$SOLUK
    tus() { local d=$2; [[ $3 ]] && d=$(dolgu "$2" "$3"); printf '%s%s%s%s%s' "$t" "$(dolgu "$1" 7)" "$R$a" "$d" "$R"; }
    printf '%s%s%s\n' "$(tus enter bağlan 11)" "$(tus ctrl-x kapat 11)" "$(tus ctrl-r 'ad değiştir')"
    printf '%s%s%s\n' "$(tus ctrl-f 'dizin seç' 11)" "$(tus ctrl-b oturumlar 11)" "$(tus '?' önizleme)"
    printf '%sYeni oturum: adını yazıp enter%sa bas%s\n' "$SARI" "'" "$R"
    printf '%s%s%s' "$a" "$(printf '─%.0s' $(seq 54))" "$R"
}

# @oturum-onizleme boşsa sağda %65, ama liste sütunu 62'den, önizleme 30'dan dar olmaz. Genişlik /dev/tty'den: fzf'nin girdisi
# boru olduğundan tput terminali görmez.
onizleme_yeri() {
    local yer sutun boy
    yer=$(secenek @oturum-onizleme '')
    [[ $yer ]] && { echo "$yer"; return; }
    read -r _ sutun < <(stty size </dev/tty 2>/dev/null)
    boy=$(( ${sutun:-100} * 65 / 100 ))
    (( ${sutun:-100} - boy < 62 )) && boy=$(( ${sutun:-100} - 62 ))
    (( boy < 30 )) && boy=30
    echo "right,$boy"
}

ad_ver() { basename "$1" | tr '.:' '__'; }

kimlik=$2
makine=${kimlik%%|*} ne=${kimlik#*|}
tur=${ne%%|*} deger=${ne#*|}
case $tur in
    dizin | yeni | yetki | kayit) ;;
    +) tur=arti ;;
    *) tur=oturum deger=$ne ;;
esac
# "+" satırındaki yeni oturumun adı makinenin adı
ad=$makine; [[ $makine == yerel ]] && ad=$YEREL

case ${1:-arayuz} in
    liste) liste ;;
    dizinler) dizinler "${makine:-yerel}" ;;
    onizle)
        case $tur in
            oturum) [[ $deger == *:* ]] || deger+=":"  # "=ad:" oturumun etkin bölmesi, "=ad:N" pencerenin
                    calistir "$makine" "tmux capture-pane -ep -t '$deger'" ;;
            dizin) calistir "$makine" "ls -A --color=always '$deger'" ;;
            kayit)
                dosya=$(kayit_dosyasi "$deger") || exit 0
                z=${dosya##*_}
                printf '%s↺ %s: kayıtlı oturum%s  %s%s.%s.%s %s:%s kaydı%s\n' "$TURUNCU$KALIN" "$deger" "$R" "$SOLUK" \
                    "${z:6:2}" "${z:4:2}" "${z:0:4}" "${z:9:2}" "${z:11:2}" "$R"
                kayit_onizle "$dosya" "$deger" "${FZF_PREVIEW_COLUMNS:-80}"
                printf '\n  %s%-8s%s%s\n' "$PEMBE" enter "$R" "pencereler, bölmeler ve dizinlerle kur, bağlan"
                printf '  %s%-8s%s%s\n' "$PEMBE" ctrl-x "$R" "kaydı unut (bütün kayıt dosyalarından)"
                printf '\n%sBölme içerikleri ve çalışan programlar gelmez; hepsi için prefix C-r.%s\n' "$SOLUK" "$R" ;;
            arti)
                printf '%s+ %s: yeni oturum%s\n\n' "$YESIL$KALIN" "$ad" "$R"
                printf "  $PEMBE%-8s$R%s\n" enter "ev dizininde aç (oturum adı: $ad)" ctrl-f "önce dizin seç"
                printf '\n%sAynı adla oturum varsa yenisi açılmaz, ona bağlanılır.%s\n' "$SOLUK" "$R" ;;
            yetki) printf '%s! %s: Tailscale SSH onayı istiyor%s\n\n' "$SARI" "$makine" "$R"
                   printf '  %senter%s ile bağlantı açılır, onay adresi orada çıkar.\n  Tarayıcıda onaylayınca liste kendiliğinden yenilenir.\n' "$PEMBE" "$R" ;;
        esac ;;
    kapat)
        [[ $tur == kayit ]] && { unut "$deger"; exit 0; }
        [[ $tur == oturum ]] || exit 0
        # Pencere satırı yalnız pencereyi kapatır. Oturum kapanmadan önce resurrect kaydı alınır (varsa): kayıtlı listesine son
        # hâliyle düşer, continuum'un 15 dk'lık aralığında yapılan değişiklik kaybolmaz
        if [[ $deger == *:* ]]; then calistir "$makine" "tmux kill-window -t '$deger'"
        else calistir "$makine" "k=\$(tmux show-option -gqv @resurrect-save-script-path); [ -x \"\$k\" ] && \"\$k\" quiet; tmux kill-session -t '$deger'"; fi ;;
    adlandir)
        [[ $tur == oturum ]] || exit 0
        # zsh ctrl-g'den açılınca terminal zle'nin ham kipinde (yazılan görünmez); okuma satır kipinde, sonra eski kip
        kip=$(stty -g </dev/tty); stty sane </dev/tty
        printf '\n'; read -rp "Yeni ad (${deger#=}): " yeni </dev/tty
        stty "$kip" </dev/tty
        [[ $yeni ]] || exit 0
        [[ $deger == *:* ]] && neyi=rename-window || neyi=rename-session
        calistir "$makine" "tmux $neyi -t '$deger' '$yeni'" ;;
    baglan)
        # Onay: ssh adresi basıp bekler; onaydan sonra bağlantı ControlMaster'da açık kalır, seçici yeniden açılır
        if [[ $tur == yetki ]]; then
            printf '%s! %s: Tailscale SSH onayı%s\n\n' "$SARI" "$makine" "$R"
            # Adres beklerken görünmeli: süreç ikamesiyle satır satır (boru tamponlanırdı)
            "${SSH[@]}" "$(hedef "$makine")" true 2> >(while IFS= read -r satir; do
                satir=${satir%$'\r'}
                case $satir in
                    *"To authenticate, visit: "*) printf '  %sAdresi tarayıcıda aç ve onayla:%s\n  %s%s%s\n\n  %sOnaydan sonra seçici kendiliğinden açılır.%s\n' \
                        "$PEMBE" "$R" "$CAMGOBEGI$KALIN" "${satir##* }" "$R" "$SOLUK" "$R" ;;
                    "# Tailscale SSH requires"*) ;;
                    *) printf '%s\n' "$satir" ;;
                esac
            done >&2) && exec "$BEN"
            read -rsn1 -p "Onay alınamadı; bir tuşa bas." </dev/tty; exec "$BEN"
        fi
        # Kayıtlı oturum önce kurulur, sonra açık oturum gibi bağlanılır
        if [[ $tur == kayit ]]; then
            kur "$deger" || { read -rsn1 -p "Kayıt okunamadı; bir tuşa bas." </dev/tty; exec "$BEN"; }
            tur=oturum deger="=$deger"
        fi
        # Aynı adla oturum varsa yenisi açılmaz, ona bağlanılır (-A); uzakta yerel $PWD yok, oturum ev dizininde açılır
        case $tur in
            oturum) komut="tmux -u attach -t '$deger'" ;;
            dizin) ad=$(ad_ver "$deger") dizin=$deger ;;
            yeni) ad=$(ad_ver "$deger") dizin=""; [[ $makine == yerel ]] && dizin=$PWD ;;
            arti) dizin=""; [[ $makine == yerel ]] && dizin=$HOME ;;
        esac
        [[ $tur == oturum ]] || komut="tmux -u new-session -A -s '$ad'${dizin:+ -c '$dizin'}"
        if [[ $makine == yerel && $TMUX ]]; then
            [[ $tur == oturum ]] || { tmux new-session -ds "$ad" -c "$dizin" 2>/dev/null; deger="=$ad"; }
            tmux switch-client -t "$deger"
        elif [[ $makine == yerel ]]; then
            eval "exec $komut"
        elif [[ $TMUX ]]; then
            # İç içe tmux yok: terminaldeki istemci uzak oturumla yer değiştirir, uzakta prefix d ile kalınan yerel oturuma dönülür.
            # Dönüşte -u: sunucudan sunucuya geçişte istemci LANG'sız ssh komutundan gelir, -u'suz Nerd Font imleri "_" olur.
            IFS=$'\t' read -r soket geri < <(tmux display-message -p $'#{socket_path}\t#{client_session}')
            tmux detach-client -E "$(printf '%q ' "${SSH[@]}" -t "$(hedef "$makine")" "$komut"); exec tmux -u -S '$soket' attach -t '=$geri'"
        else
            exec "${SSH[@]}" -t "$(hedef "$makine")" "$komut"
        fi ;;
    arayuz)
        # --exact: bulanık aramada "fir" _dotfiles'ın f-i'si ve "pencere"nin r'siyle eşleşirdi; her satırda geçen "pencere",
        # "yeni oturum" gibi sözcükler yüzünden ilgisiz satırlar kalırdı. Bulanık arama için sorgunun başına '
        # Kabuğun fzf ayarı (--tmux açılır penceresi) burada istenmez: arayüz zaten açılır pencerede ya da tam ekranda
        eval "ek=($(secenek @oturum-fzf ''))"
        # ctrl-f ile açılan dizin listesinin makinesi: listede olmayan ad + enter yeni oturumu o makinede açar
        durum=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/tmux-oturum-durum.XXXXXX")
        trap 'rm -f "$durum"' EXIT
        # Listeyi fzf başlatır: esc'te onu öldürüp hemen çıkar (boruyla verilince yanıt vermeyen makinenin 5 sn'si beklenirdi)
        cikti=$(FZF_DEFAULT_COMMAND="'$BEN' liste" FZF_DEFAULT_OPTS='' fzf --ansi --print-query --delimiter '\t' --with-nth 2 --layout reverse \
            --prompt 'oturum ❯ ' --pointer '▶' --scrollbar '▌▐' \
            --header "$(baslik)" \
            --preview "'$BEN' onizle {1}" --preview-window "$(onizleme_yeri)" \
            --bind "ctrl-x:execute-silent('$BEN' kapat {1})+reload('$BEN' liste)" \
            --bind "ctrl-r:execute('$BEN' adlandir {1})+reload('$BEN' liste)" \
            --bind "ctrl-f:execute-silent(printf '%s' {1} > '$durum')+reload('$BEN' dizinler {1})" \
            --bind "ctrl-b:execute-silent(: > '$durum')+reload('$BEN' liste)" --bind '?:toggle-preview' \
            --bind 'change:transform:[[ -n {q} ]] && echo "change-with-nth(3)" || echo "change-with-nth(2)"' --tiebreak index \
            --exact \
            "${ek[@]}")
        [[ $? == 130 ]] && exit 0
        sorgu=$(sed -n 1p <<<"$cikti")
        secim=$(sed -n 2p <<<"$cikti" | cut -f1)
        hedef=$(<"$durum"); hedef=${hedef%%|*}
        rm -f "$durum"
        if [[ $secim ]]; then exec "$BEN" baglan "$secim"; elif [[ $sorgu ]]; then exec "$BEN" baglan "${hedef:-yerel}|yeni|$sorgu"; fi ;;
    *)
        echo "kullanım: oturum [liste | dizinler | onizle | kapat | adlandir | baglan <kimlik>]" >&2; exit 2 ;;
esac
